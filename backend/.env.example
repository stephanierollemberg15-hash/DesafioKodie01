# Porta onde o servidor Express irá rodar
PORT=3001

# Chave de API do Google Gemini
# Obtenha sua chave gratuita em: https://aistudio.google.com/
GEMINI_API_KEY=sua_chave_gemini_aqui

# Modelo preferencial do Gemini
GEMINI_MODEL=gemini-2.5-flash

# URL do Webhook do seu fluxo no n8n (o fluxo é disparado aqui)
N8N_WEBHOOK_URL=https://seu-n8n.com/webhook/seu-id
